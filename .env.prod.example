# Produção / Homologação (VPS) — no servidor: copie para `.env` e preencha.
# Este arquivo é lido pelo docker-compose.prod.yml.
# ---------------------------------------------------------------------------

APP_NAME="Mentis Semear"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://mentis.kassiosousa.com.br

# Gere uma vez e cole aqui:
#   docker compose -f docker-compose.prod.yml run --rm php php artisan key:generate --show
APP_KEY=

# Segredo do JWT. Gere uma vez e cole aqui:
#   docker compose -f docker-compose.prod.yml run --rm php php artisan jwt:secret --show
JWT_SECRET=
JWT_TTL=60

# Banco de dados (as credenciais do app e do container MySQL devem bater)
DB_DATABASE=mentis_semear
DB_USERNAME=mentis
DB_PASSWORD=troque-esta-senha
DB_ROOT_PASSWORD=troque-esta-senha-root

# Porta do host onde o nginx do app escuta.
# Aponte seu proxy reverso / terminação HTTPS (Nginx, Traefik, Caddy...) para ela.
APP_PORT=8080
