# Normalize line endings; force LF so shell scripts/Dockerfiles run on Linux.
* text=auto eol=lf

*.sh        text eol=lf
Dockerfile  text eol=lf
*.conf      text eol=lf
*.ini       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg text eol=lf
*.ico binary
