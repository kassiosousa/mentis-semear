# Copy to .env — consumed by docker-compose.yml
# ---------------------------------------------------------------------------

# Database
DB_DATABASE=mentis_semear
DB_USERNAME=mentis
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root
# Host port used to reach MySQL from your machine (container always uses 3306).
DB_HOST_PORT=3306

# Exposed host ports
BACKEND_PORT=8080
FRONTEND_PORT=5173
